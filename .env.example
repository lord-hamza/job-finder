# Copy to .env (run.sh does this for you). You can also fill these in from the dashboard.

# From https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Your Gmail address, and a 16-character App Password from
# https://myaccount.google.com/apppasswords (needs 2-Step Verification on).
# Your normal Gmail password will not work.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional. Defaults are shown.
# GEMINI_MODEL=gemini-flash-lite-latest
# MIN_MATCH_SCORE=60     # crawled jobs scoring below this are skipped
# DAILY_SEND_LIMIT=25    # hard cap on emails and forms per day
# CRAWL_MAX_JOBS=15      # job pages opened per link
